{
  "name": "notifymvp",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notifymvp-db",
      "database_id": "9e1e6db0-c22f-4dab-b6be-01dfaaa05e1d"
    }
  ],

  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://notify.earnslash.com"
  },

  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}