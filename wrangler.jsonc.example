{
  "name": "notifymvp",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],

  // After: npx wrangler d1 create notifymvp-db — paste your database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notifymvp-db",
      "database_id": "YOUR-D1-DATABASE-ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "firebase-credentials"
    }
  ],

  // Your Worker origin (no trailing slash). Also set BETTER_AUTH_URL secret to the same value.
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://notify.yourdomain.com"
  },

  "main": ".open-next/worker.js",

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
